{
    "name": "agent-crew",
    "version": "0.1.0",
    "private": true,
    "description": "Run many coding agents from one window",
    "license": "MIT",
    "type": "module",
    "main": "out/main/app.js",
    "engines": {
        "node": ">=20.19",
        "pnpm": "^9.6.0"
    },
    "scripts": {
        "build": "electron-vite build",
        "clear": "rm -rf node_modules/ out/",
        "lint": "oxlint",
        "lint:diff": "git diff --name-only --diff-filter=d main | grep -E '\\.tsx?' | xargs pnpm oxlint",
        "pretty": "prettier . --write",
        "rebuild": "electron-rebuild -f -w node-pty",
        "serve": "electron-vite preview",
        "setup": "pnpm install && pnpm start",
        "start": "electron-vite dev",
        "start:check": "pnpm tsc --project tsconfig.json --watch",
        "test": "jest",
        "test:coverage": "jest --coverage --colors",
        "test:watch": "jest --watch",
        "postinstall": "node script/fix-pty.mjs"
    },
    "dependencies": {
        "@xterm/addon-fit": "~0.10.0",
        "@xterm/addon-serialize": "~0.13.0",
        "@xterm/xterm": "~5.5.0",
        "clsx": "~2.1.1",
        "node-pty": "~1.1.0-beta34",
        "react": "~18.3.1",
        "react-dom": "~18.3.1"
    },
    "devDependencies": {
        "@electron/rebuild": "~4.0.1",
        "@swc/jest": "~0.2.23",
        "@types/jest": "~29.5.14",
        "@types/node": "~22.10.0",
        "@types/react": "~18.3.3",
        "@types/react-dom": "~18.3.0",
        "@vitejs/plugin-react": "~4.3.1",
        "electron": "~44.3.0",
        "electron-vite": "~5.0.0",
        "eslint-plugin-import": "~2.32.0",
        "identity-obj-proxy": "~3.0.0",
        "jest": "~29.7.0",
        "oxlint": "~1.66.0",
        "oxlint-plugin-eslint": "~1.66.0",
        "prettier": "~3.0.3",
        "typescript": "~5.7.0",
        "vite": "~6.2.3"
    }
}
